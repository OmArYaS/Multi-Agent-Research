# Multi-Agent Research & Workflow Orchestrator - environment configuration
# Copy this file to .env and adjust as needed.

# Local Ollama (model-agnostic). Swap OLLAMA_MODEL to gemma2, deepseek-r1,
# llama3.1, or any open-source Ollama model — no code changes required.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_k_m

# Workflow
MAX_ITERATIONS=2
SEARCH_MAX_RESULTS=5

# Persistence
DB_PATH=research_runs.db
